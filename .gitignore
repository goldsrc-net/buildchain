# CI signing keys — private, never committed.
/ci-secrets/

# Agent / IDE state — local-only, never committed.
/.claude/
/.serena/

# Build outputs land inside each consumer-project submodule
# (build-<arch>/ for cmake, build_<arch>/ for AMBuild) — those are
# tracked by each submodule's own .gitignore.

# Release zips assembled by scripts/fetch-release-artifacts.sh
# (downloaded from consumer CI runs; produced fresh on demand).
/release-assets/

# Drop-in zips composed by scripts/build-dropins.sh.
/release-dropins/

# Steam CDN packages cached during drop-in builds (content-addressed,
# refetches are idempotent).
/release-cache/

# Local notes — agent transcripts, working drafts.
/notes/
